  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuan-source-666/dsh-ptc-discipline.git"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "agent-preset",
    "ptc",
    "goal",
    "todo",
    "discipline"
  ],
  "scripts": {
